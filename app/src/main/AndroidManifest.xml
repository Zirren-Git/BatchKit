<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BatchKit is a fully offline, local device-management tool: it lists the apps
         installed on this device so the user can batch-manage them. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Optional: used only to sort apps by "last used". Never sent anywhere. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Shizuku API permission: the Shizuku app checks this before handing over its binder. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".BatchKitApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BatchKit">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|smallestScreenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BatchKit"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          All privileged work happens in this service. It runs in its own process
          (:privileged) and executes every request on a background dispatcher, so the
          UI process never blocks on a Shizuku binder call.
        -->
        <service
            android:name=".privileged.PrivilegedActionService"
            android:exported="false"
            android:process=":privileged" />

        <!-- Quick Settings tile: applies the pinned profile in one tap. -->
        <service
            android:name=".tile.ProfileTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Shizuku: the provider receives the privileged binder from the Shizuku app.
          It MUST run in the main process only: Shizuku throws
          "IllegalStateException: android:multiprocess must be false" while the
          provider is installed, which kills the process before any app code runs.
          Every process that needs the binder opts in with
          ShizukuProvider.enableMultiProcessSupport() instead (see BatchKitApp).
          INTERACT_ACROSS_USERS_FULL keeps other apps out of the provider; only
          Shizuku (running as shell) holds it.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
