    <string name="action_force_stop">Force stop</string>
    <string name="action_force_stop_desc">Kills the app process immediately. It can start again on its own.</string>
    <string name="action_block_background">Block background run</string>
    <string name="action_block_background_desc">Sets the run_in_background app op to ignore, so the app cannot start work on its own.</string>
    <string name="action_block_any_background">Block ANY background run</string>
    <string name="action_block_any_background_desc">Sets run_any_in_background to ignore. Stricter: also blocks short background windows.</string>
    <string name="action_restore_background">Restore background run</string>
    <string name="action_restore_background_desc">Removes the app op override and puts the app back to the system default.</string>
    <string name="action_freeze">Freeze (disable)</string>
    <string name="action_freeze_desc">Disables the app for this user. It disappears from the launcher until unfrozen.</string>
    <string name="action_unfreeze">Unfreeze (enable)</string>
    <string name="action_unfreeze_desc">Re-enables a frozen app.</string>
    <string name="action_battery_exempt">Battery optimization OFF</string>
    <string name="action_battery_exempt_desc">Adds the app to the device idle whitelist so the system stops dozing it.</string>
    <string name="action_battery_uneempt">Battery optimization ON</string>
    <string name="action_battery_uneempt_desc">Removes the app from the device idle whitelist.</string>
    <string name="action_clear_cache">Clear cache</string>
    <string name="action_clear_cache_desc">Deletes the app cache directory. App data is not touched.</string>
    <string name="action_notifications_off">Notifications OFF</string>
    <string name="action_notifications_off_desc">Blocks notifications for the app.</string>
    <string name="action_notifications_on">Notifications ON</string>
    <string name="action_notifications_on_desc">Allows notifications for the app again.</string>

